# Global Environment Configuration
NODE_ENV=development
PROJECT_NAME=Venus
VERSION=1.0.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Venus
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_key_here

# Backend Server
PORT=5000
HOST=localhost
API_VERSION=v1

# Database
DATABASE_URL=postgresql://venus_user:venus_password@localhost:5432/venus_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=venus_db
DATABASE_USER=venus_user
DATABASE_PASSWORD=venus_password
DATABASE_SSL=false

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
ADMIN_JWT_SECRET=admin_secret_key_change_this

# OCR Service Configuration
OCR_SERVICE=tesseract
# Options: tesseract, aws-textract, google-vision
TESSERACT_PATH=/usr/bin/tesseract
OCR_API_KEY=your_ocr_api_key
OCR_ENDPOINT=https://api.ocr-service.com
OCR_TIMEOUT=30000
OCR_LANGUAGE=eng
OCR_CONFIDENCE_THRESHOLD=0.8

# AWS Configuration (for Textract or S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=venus-uploads
AWS_TEXTRACT_ENABLED=false

# Google Vision API (Alternative OCR)
GOOGLE_VISION_API_KEY=your_google_vision_key
GOOGLE_PROJECT_ID=your_google_project_id

# Payment Gateway Configuration
PAYMENT_PROVIDER=stripe
# Options: stripe, paypal, square

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret
STRIPE_API_VERSION=2023-10-16

# PayPal Configuration (Alternative)
PAYPAL_MODE=sandbox
# Options: sandbox, live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id

# Square Configuration (Alternative)
SQUARE_ENVIRONMENT=sandbox
# Options: sandbox, production
SQUARE_ACCESS_TOKEN=sq_test_your_access_token
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_APPLICATION_ID=your_square_app_id

# File Upload & Storage
FILE_UPLOAD_LIMIT=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
MAX_FILE_SIZE=10485760
STORAGE_PROVIDER=local
# Options: local, s3, azure-blob

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@venuscorporate.com
SMTP_SECURE=true

# Sendgrid Alternative
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@venuscorporate.com

# Logging & Monitoring
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=your_sentry_dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_key
SESSION_EXPIRY=3600000

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_EXPORT=true
FEATURE_IMPORT=false
FEATURE_OCR=true
FEATURE_PAYMENT=true
FEATURE_ADMIN=true

# Admin Panel
ADMIN_EMAIL_DOMAIN=@venuscorporate.com
ADMIN_PANEL_URL=http://localhost:3001
ADMIN_ENABLE_LOGS=true

# Twilio (for SMS/OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret
RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# External APIs
EXTERNAL_API_KEY=
EXTERNAL_API_URL=

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# API Rate Limits per Endpoint
API_RATE_LIMIT_OCR=50
API_RATE_LIMIT_PAYMENT=100
API_RATE_LIMIT_UPLOAD=20

# Document Processing
DOCUMENT_VALIDATION_REQUIRED=true
DOCUMENT_VIRUS_SCAN=true
DOCUMENT_EXPIRY_DAYS=365
